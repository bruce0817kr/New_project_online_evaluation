# Backend Environment Variables

# Database
DATABASE_URL=postgresql://sme_admin:sme_secure_pass_2024@localhost:5432/sme_evaluation

# Security
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# File Upload
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=52428800

# OCR Settings
OCR_LANGUAGE=kor+eng
OCR_CONFIG=--psm 6 --oem 3
OCR_FALLBACK_STRATEGY=on_low_confidence  # none, on_failure, on_low_confidence, always
OCR_CONFIDENCE_THRESHOLD=0.85
OCR_ENABLE_ENSEMBLE=false

# AI Vision API Keys (선택적 - 폴백용)
# Tesseract만 사용하려면 아래 키들을 비워두세요
OPENAI_API_KEY=  # sk-... (GPT-4o Vision)
GOOGLE_API_KEY=  # Google Gemini API Key
MISTRAL_API_KEY=  # Mistral Pixtral API Key
